# =============================================
# .env 템플릿 — 이 파일을 복사해 .env 로 저장하고 실제 키를 넣으세요
# (형식: KEY=값, 따옴표는 있어도 되고 없어도 됨, # 는 주석)
# =============================================

# OpenAI — Interpreter/Retriever/Summarizer/Evaluator/Critic 이 사용
OPENAI_API_KEY=sk-proj-...

# Anthropic — Improver(정책 개선안), LLM Judge 가 사용
ANTHROPIC_API_KEY=sk-ant-...

# (선택) 모델 오버라이드
# OPENAI_MODEL=gpt-5.2
# A2A_MODEL_SUMMARY=gpt-5.2
# A2A_MODEL_POLICY=claude-sonnet-5
# JUDGE_PROVIDER=anthropic
# JUDGE_MODEL=claude-sonnet-5
# JUDGE_OPENAI_MODEL=gpt-5.4-mini
# JUDGE_ANTHROPIC_MODEL=claude-sonnet-5

# (선택) 30초 목표용 저지연 설정
# OPENAI_REASONING_EFFORT=none
# OPENAI_VERBOSITY=low
# OPENAI_MAX_COMPLETION_TOKENS=900
# INTERPRETER_MAX_OUTPUT_TOKENS=300
# CRITIC_MAX_COMPLETION_TOKENS=500
# JUDGE_OPENAI_MAX_COMPLETION_TOKENS=2000
# ANTHROPIC_EFFORT_POLICY=low
# ANTHROPIC_THINKING_POLICY=disabled
# ANTHROPIC_EFFORT_JUDGE=low
# ANTHROPIC_THINKING_JUDGE=disabled

# (선택) VOC CSV 경로 오버라이드
# A2A_VOC_CSV=d:\voc\voc.csv

# (선택) 에이전트 서버 주소 오버라이드 - 기본값은 전부 localhost:6001~6006
# 여러 머신에 에이전트를 분산 배포할 때만 필요
# INTERPRETER_ENDPOINT=localhost:6001
# RETRIEVER_ENDPOINT=localhost:6002
# SUMMARIZER_ENDPOINT=localhost:6003
# EVALUATOR_ENDPOINT=localhost:6004
# CRITIC_ENDPOINT=localhost:6005
# IMPROVER_ENDPOINT=localhost:6006

# (선택) 서버 바인드 주소 오버라이드 - 기본값은 0.0.0.0:포트
# INTERPRETER_BIND=0.0.0.0:6001
# CRITIC_BIND=0.0.0.0:6005
# IMPROVER_BIND=0.0.0.0:6006

# (선택) LLM 호출 재시도/폴백 설정
# LLM_MAX_ATTEMPTS=3
# LLM_ALLOW_FALLBACK=true

# (선택) 생성 공급자 지정 (interpreter/critic/summarizer 등)
# GENERATION_PROVIDER=openai

# (선택) llm_judge.py 내부 실험용 플래그
# JUDGE_LOCK_PROVIDER=anthropic
# CROSS_VALIDATION_EXPERIMENT=false
